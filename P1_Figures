# BUILD X-AXIS LABELS TO INCLUDE VARIABLE NAME AND REPLICATES (N)
def format_nitrogen_label(level):
    level = str(level)
    level = level.replace(" of ", " ")
    level = level.replace(" of", "")

    # glutamic acid: new line only after g/L
    level = level.replace(" g/L Glutamic acid", " g/L\nGlutamic acid")

    # mixed nitrate treatments: new line after NH4NO3
    level = level.replace("0.824 g/L NH4NO3, 0.95 g/L KNO3", "0.824 g/L NH4NO3\n0.95 g/L KNO3")
    level = level.replace("0.824 g/L NH4NO3, 0.771 g/L CaNO3", "0.824 g/L NH4NO3\n0.771 g/L CaNO3")

    return level

def build_xlabels(summary_df):
    labels = []

    for _, row in summary_df.iterrows():
        level = format_nitrogen_label(row["level"])
        reps = int(row["total_plants"]) if pd.notna(row["total_plants"]) else 0
        labels.append(f"{level}\nn={reps}")

    return labels


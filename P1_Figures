import numpy as np
import pandas as pd
import matplotlib.pyplot as plt





## FIGURE 1 — MEAN WEIGHTED GROWTH RESPONSES FOR SUCROSE AND SEAWATER
## FILTERS THE WEIGHTED SUMMARY TABLE TO INCLUDE ONLY SUCROSE AND SEAWATER
suc = (
    weighted_summary[
        (weighted_summary["factor"] == FAC_SUC) &
        (weighted_summary["metric"] == "Growth Rate")
    ]
    .copy()
    .sort_values("level")
    .reset_index(drop=True)
)

sw = (
    weighted_summary[
        (weighted_summary["factor"] == FAC_SW) &
        (weighted_summary["metric"] == "Growth Rate")
    ]
    .copy()
    .sort_values("level")
    .reset_index(drop=True)
)

# CALCULATE BINOMIAL STANDARD ERROR (NOT DONE IN STATS)
def add_plot_stats(summary_df):
    summary_df = summary_df.copy()
    summary_df["percent"] = summary_df["weighted_rate"] * 100
    summary_df["se"] = np.sqrt(
        (summary_df["weighted_rate"] * (1 - summary_df["weighted_rate"]))
        / summary_df["total_plants"]
    )
    summary_df["se_percent"] = summary_df["se"] * 100
    return summary_df

suc = add_plot_stats(suc)
sw  = add_plot_stats(sw)

# BUILD X-AXIS LABELS TO INCLUDE VARIABLE NAME AND REPLICATES (N)
def build_xlabels(summary_df):
    labels = []

    for _, row in summary_df.iterrows():
        level = str(row["level"])
        reps = int(row["replicates"]) if pd.notna(row["replicates"]) else 0
        labels.append(f"{level}\nn={reps}")

    return labels

suc_labels = build_xlabels(suc)
sw_labels  = build_xlabels(sw)


# PANEL PLOTTING TO INCLUDE ERROR BARS AND FIX FORMATTING
def plot_growth_panel(ax, summary_df, labels, title, xlabel):
    x = np.arange(len(summary_df))

    bars = ax.bar(
        x,
        summary_df["percent"],
        yerr=summary_df["se_percent"],
        capsize=5
    )

    ax.set_xticks(x)
    ax.set_xticklabels(labels)
    ax.set_title(title)
    ax.set_xlabel(xlabel)
    ax.set_ylim(0, 50)
    ax.set_yticks(np.arange(0, 51, 10))
    ax.grid(axis="y", linestyle="--", linewidth=0.7, alpha=0.7)
    
    # LABELS THE MEAN AND ERROR VALUE ABOVE THE CAP OF THE ERROR BAR
    for i, bar in enumerate(bars):
        mean_val = summary_df.loc[i, "percent"]
        err_val  = summary_df.loc[i, "se_percent"]
        y_cap = mean_val + err_val

        # PUTS THE ERROR TEXT ABOVE THE CAP
        ax.text(
            bar.get_x() + bar.get_width() / 2,
            y_cap + 0.3,
            f"±{err_val:.1f}",
            ha="center",
            va="bottom",
            fontsize=9
        )
        
        # PUTS THE MEAN TEXT MORE ABOVE THE CAP TO BE ABOVE STD
        ax.text(
            bar.get_x() + bar.get_width() / 2,
            y_cap + 1.6,
            f"{mean_val:.1f}%",
            ha="center",
            va="bottom",
            fontsize=10
        )
 
# BUILDS THE FIGURE
fig, axes = plt.subplots(1, 2, figsize=(12, 6), sharey=True)

## SUCROSE GRAPH
plot_growth_panel(
    ax=axes[0],
    summary_df=suc,
    labels=suc_labels,
    title="Sucrose Concentration",
    xlabel="Sucrose Concentration (g/L)"
)

## SEAWATER GRAPH
plot_growth_panel(
    ax=axes[1],
    summary_df=sw,
    labels=sw_labels,
    title="Seawater Concentration",
    xlabel="Seawater Concentration (%)"
)

axes[0].set_ylabel("Mean Weighted Growth (%)")

fig.suptitle(
    "Figure 1. Mean weighted growth responses across trials associated with\n"
    "sucrose concentration and seawater concentration",
    fontsize=13
)

plt.tight_layout()
plt.savefig("Figure1_Growth_Sucrose_Seawater.png", bbox_inches="tight")
plt.show()





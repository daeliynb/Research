## FIGURE 6 — MEAN WEIGHTED GROWTH AND CONTAMINATION ACROSS TRIALS
## FILTERS THE WEIGHTED SUMMARY TABLE TO INCLUDE ONLY TRIAL DATA
trial_growth = (
    weighted_summary[
        (weighted_summary["factor"] == FAC_TRIAL) &
        (weighted_summary["metric"] == "Growth Rate")
    ]
    .copy()
    .sort_values("level")
    .reset_index(drop=True)
)

trial_contam = (
    weighted_summary[
        (weighted_summary["factor"] == FAC_TRIAL) &
        (weighted_summary["metric"] == "Contamination Rate")
    ]
    .copy()
    .sort_values("level")
    .reset_index(drop=True)
)

## ORDERS THE TRIALS
trial_growth["level"] = pd.to_numeric(trial_growth["level"], errors="coerce")
trial_contam["level"] = pd.to_numeric(trial_contam["level"], errors="coerce")

trial_growth = trial_growth.sort_values("level").reset_index(drop=True)
trial_contam = trial_contam.sort_values("level").reset_index(drop=True)

## ADD PLOTTING COLUMNS BY TURNING THE WEIGHTED RATE INTO A PERCENT AND ADDING STD
def add_plot_stats(df):
    df = df.copy()

    df["percent"] = df["weighted_rate"] * 100

    df["se"] = np.sqrt(
        (df["weighted_rate"] * (1 - df["weighted_rate"])) / df["total_plants"]
    )

    df["se_percent"] = df["se"] * 100

    return df

trial_growth = add_plot_stats(trial_growth)
trial_contam = add_plot_stats(trial_contam)

## CREATES THE X-AXIS LABELS 
trial_labels = []

for i in range(len(trial_growth)):
    trial_num = int(trial_growth.loc[i, "level"])
    reps = int(trial_growth.loc[i, "total_plants"]) if pd.notna(trial_growth.loc[i, "total_plants"]) else 0

    trial_labels.append(f"{trial_num}\nn={reps}")

## BUILDS THE FIGURE
fig, ax = plt.subplots(figsize=(10, 7))

# GROWTH LINE
ax.errorbar(
    trial_growth["level"],
    trial_growth["percent"],
    yerr=trial_growth["se_percent"],
    marker='o',
    capsize=5,
    label="Growth"
)

# CONTAMINATION LINE
ax.errorbar(
    trial_contam["level"],
    trial_contam["percent"],
    yerr=trial_contam["se_percent"],
    marker='s',
    capsize=5,
    label="Contamination"
)

# FORMATTNG
